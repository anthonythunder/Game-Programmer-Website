---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PersonalProjects } from "../../data/projects.js";

export async function getStaticPaths() {
  return PersonalProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
// Ensures permalink acts as a fully qualified path based on local domain / dev origin
const permalink = `${Astro.site?.href || Astro.url.origin + "/"}${baseUrl}projects/${project.slug}`;
---

<BaseLayout
  title={project.name}
  description={project.description}
  permalink={permalink}
>
  <section class="hero-video">
    <img src={project.image} alt={project.name} />
    <div class="hero-overlay"></div>

    <div class="hero-about" id="about">
      <div class="about-content">
        <h2>{project.name}</h2>
        <p>{project.description}</p>
      </div>
      <div class="software-tags-hero">
        <strong>Software used: </strong>
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </section>

  <section class="project-detail">
    <div class="project-content">
      <div class="media-section">
        <h2>Media Highlights</h2>
        <div class="media-grid">
          {
            project.media.map((item) =>
              item.type === "video" ? (
                <video src={item.url} controls loop muted playsinline />
              ) : (
                <img src={item.url} alt={`${project.name} media`} />
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-video {
    position: relative;
    width: 100%;
    height: 25dvh;
  }

  .hero-video img {
    position: absolute;
    opacity: 25%;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-about {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
  }

  .about-content {
    position: absolute;
    text-align: left;
    left: 180px;
    max-width: 800px;
  }

  .about-content h2 {
    font-size: 3em;
    margin-top: 0em;
    color: #fff;
  }

  .about-content p {
    font-size: 1em;
    margin-bottom: 1em;
    color: #ddd;
    line-height: 1.4;
  }

  .software-tags-hero {
    position: absolute;
    bottom: 3rem;
    right: 160px;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
    color: #fff;
  }

  .project-detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
    color: #fff;
    min-height: 100vh;
  }

  .tag {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .media-section h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.8rem;
    color: #ebebeb;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2.5rem;
  }

  .media-grid img,
  .media-grid video {
    width: 1024px;
    height: 576px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .media-grid img:hover,
  .media-grid video:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 800px) {
    .hero-about {
      top: 60%;
    }
    .about-content {
      left: 20px;
      right: 20px;
    }
    .software-tags-hero {
      left: 20px;
      bottom: 2rem;
    }
    .about-content h2 {
      font-size: 2.5em;
    }
    .about-content p {
      font-size: 1.2em;
    }
    .media-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
