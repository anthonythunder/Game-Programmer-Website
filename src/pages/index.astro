---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Anthony D\'souza';
const description = 'Gameplay programmmer';
const permalink = Astro.site.href;

const ProfesionalProjects = [
  {
    name : "Thermoverse",
    image : "/assets/Images/Thermax Logo 2_.png",
    tags : ["Unity" , "C#"],
    description : "internal Training/learning application for Thermax Limited", 
    note : "Application was for internal use and not publicly released."
  },
  { 
    name : "Drone Simulator",
    image : "/assets/Images/Drone simulator.png",
    tags : ["Unity" , "C#"],
    description : "Contributed to the development of a VR-based drone simulator used for training and operational practice.This is a demo project",
    note : ""
  },
  {
    name : "Demo Project",
    image : "",
    tags : ["Unity" , "C#"],
    description : "This is a demo project",
    note : ""
  }
];

const PersonalProjects = [
{
  name : "Botw Prototype",
  image : `assets/Images/Botw-Project-Img.png`,
  tags : ["Unity"],
  description : "This is a Third-persorn protype inspired by the Legend of Zelda : Breath of the Wild",
  note : ""
},{
  name : "First stop",
  image : `assets/Images/First stop.png`,
  tags : ["Unity"],
  description : "Contributed as a gameplay programmer to create a boss rush game for jam",
  note : ""
}
] ;
---

<!--Home section-->

<BaseLayout title={title} description={description} permalink={permalink}>
  
  <!--Video section -->

  <section id ="home" class = "hero-video">
<video id = "hero-video" src= 'assets/gameplay.mp4' autoplay muted loop>
</video>
<div class = "hero-overlay"></div>
 
<div class = "hero-about">
<div class = "about-content">
      <h2 >Hi, I'm Anthony Dsouza</h2>
      <p> I'm a Game developer</p>
</div>
</div>

</section>


<!--Project section -->

<section id = "project" class = "project-section">
<header class = "project-header">
<h2>Professional projects</h2>

</header>

<div class = "project-grid">

{ProfesionalProjects.map((projects) =>( 
  <article class = "project-card">
    <img src={projects.image} alt = {projects.title}/>

    <h3>{projects.name}</h3>

    <div class = "project-tags">
      {projects.tags.map((tag) => ( 
        <span class = "tag"> {tag} </span>
      ))}

    </div>

    <p class="project-description">
      {projects.description}
    </p>

    <i>{projects.note}</i>
    
  </article>
))}

</div>
</section>

<!--Personal projects -->

<section id = "project" class = "project-section">
<header class = "project-header">
<h2>Personal work</h2>

</header>

<div class = "project-grid">

{PersonalProjects.map((projects) =>( 
  <article class = "project-card">
    <img src={projects.image} alt = {projects.title}/>

    <h3>{projects.name}</h3>

    <div class = "project-tags">
      {projects.tags.map((tag) => ( 
        <span class = "tag"> {tag} </span>
      ))}
    </div>

    <p class="project-description">
      {projects.description}
    </p>

    
  </article>
))}

</div>
</section>

<!--Contact-->

<section class = "contact-section">

  <h2>Contact me</h2>

</section>

</BaseLayout>

<style>

  .home-container {
    align-items: center;
    text-align: center;
    display: flex;
    flex: 1;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.4em;
  }

  /*Project*/

  .project-section{
    h
  }

  .project-header{
    height: 100px;
    
    text-align: center;
    background-color: #000000;
    /* margin-bottom: 0rem; */
  }

  .project-header h2{
    font-size: 2.2rem:
    margin-bottom: 1.5em;
    text-align: center;
  }

  .project-section h2{
      font-size: 2.2rem:
      margin-bottom: 1.5em;
      text-align: center;
  }

  .project-grid{ 
    display:grid;
    grid-template-columns: repeat(3,1fr);
    gap: 3em;
  }

  .project-card{
    justify-self: center;
    background : #292930ac;
    width: 360px;
    padding : 1.5em;
    border-radius : 16px;
    box-shadow : 0 4px 15px rgba(0, 0, 0, 0.084);
    transition : transform 0.2s ease;
  }
  .project-card img{
    display: block;
    margin: 0 auto; 
    margin-top: 1em;
    margin-bottom: 2em;
    max-width: 280px;
    max-height: 280px;
  }

  .project-card i{
    font-size: .65em;
  }

  .project-tags{
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.8rem;
  }

  .project-description{
    font-size: 0.85em;
  }

  .project-card:hover{
  transform :translateY(-5px);
  }

  .project-card h3{
  margin-botom : 0.5em;
  font-size: 1.5 rem;
  }

  .project-card p {
  opacity : 0.8;
  line-height: 1.4;
  }

  .caption {
    font-size: .8em;
    font-style: italic;
    text-align: left;
  }
  /*hero video*/ 

  .hero-video {
    position: relative;
    width : 100%;
    height: 100dvh;
    /* overflow: hidden; */
  }

  .hero-video video {
    position: absolute;
    opacity: 75%;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit:cover;
  }

  .hero-overlay{
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.14),
      rgba(0,0,0,0.6),
      rgba(0,0,0,0.95)
    );
  }
  /* .hero-about{
        background-color: #012f55;
        position:absolute;
  } */

  .hero-about{
    background-color: #292930db;
    position:absolute;
    inset: 0;
    z-index : 2;

    display: flex;
    flex-direction:column;
    align-items:stretch;
    justify-content:center;
    Top : 450px;
  }
  .about-content {

    position:absolute;

    text-align:left;
    top : 0px;
    left: 160px;  
  }

  .about-content p{
    font-size: .8em;
  }

  /* Contact */
  .contact-section{
    
    background-color: #575757;
  }
  .contact-section h2{
    text-align: center;
  
  }
  

  @media (max-width: 1200px) {
    p {
      font-size: 1.2em;
    }

    .hero-image {
      max-width: 400px;
    }
  }

  @media (max-width: 800px) {
    .home-container {
      flex-direction: column;
    }

    .home-copy {
      flex: 0;
      padding-bottom: 2em;
      text-align: center;
    }
  }
</style>

<script>
  const video = document.getElementById("hero-video");

  if (video instanceof HTMLVideoElement) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { threshold: 0.25 }
    );

    observer.observe(video);
  }
</script>

