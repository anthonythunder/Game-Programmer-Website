---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Anthony D'souza";
const description = "Gameplay programmmer";
const email = "dsouzaanthony781@gmail.com";
const phone = "+91 9325374664";
const github = "https://github.com/anthonythunder";
const linkdin = "https://www.linkedin.com/in/anthony-dsouza-12o4/";
const permalink = Astro.site.href;

const ProfesionalProjects = [
  {
    name: "Thermoverse",
    image: `assets/Images/Thermax Logo 2_.png`,
    tags: ["Unity", "C#"],
    description: "internal Training/learning application for Thermax Limited",
    note: "Application was for internal use and not publicly released.",
  },
  {
    name: "Drone Simulator",
    image: `assets/Images/Drone simulator.png`,
    tags: ["Unity", "C#"],
    description:
      "Contributed to the development of a VR-based drone simulator used for training and operational practice.This is a demo project",
    note: "",
  },
  {
    name: "Insas Gun Assembly VR",
    image: `assets/Images/Insas Gun thumbnail.png`,
    tags: ["Unity", "C#"],
    description: "This is a demo project",
    note: "",
  },
];

const PersonalProjects = [
  {
    name: "Botw Prototype",
    image: `assets/Images/Botw-Project-Img.png`,
    tags: ["Unity"],
    description:
      "This is a Third-persorn protype inspired by the Legend of Zelda : Breath of the Wild",
    note: "",
  },
  {
    name: "First stop",
    image: `assets/Images/First stop.png`,
    tags: ["Unity"],
    description:
      "Contributed as a gameplay programmer to create a boss rush game for jam",
    note: "",
  },
];
---

<!--Home section-->
<BaseLayout title={title} description={description} permalink={permalink}>
  <!--Video section -->

  <section id="home" class="hero-video">
    <video id="hero-video" src=`assets/gameplay.mp4` autoplay muted loop>
    </video>
    <div class="hero-overlay"></div>

    <div class="hero-about">
      <div class="about-content">
        <h2>Hi, I'm Anthony Dsouza</h2>
        <p>I'm a Game developer</p>
      </div>
    </div>
  </section>

  <!--Project section -->

  <section id="project" class="project-section">
    <header class="project-header">
      <h2>Professional projects</h2>
    </header>

    <div class="project-grid">
      {
        ProfesionalProjects.map((projects) => (
          <article class="project-card">
            {projects.image && <img src={projects.image} alt={projects.name} />}

            <h3>{projects.name}</h3>

            <div class="project-tags">
              {projects.tags.map((tag) => (
                <span class="tag"> {tag} </span>
              ))}
            </div>

            <p class="project-description">{projects.description}</p>

            <i>{projects.note}</i>
          </article>
        ))
      }
    </div>
  </section>

  <!--Personal projects -->

  <section id="project" class="project-section">
    <header class="project-header">
      <h2>Personal work</h2>
    </header>

    <div class="project-grid">
      {
        PersonalProjects.map((projects) => (
          <article class="project-card">
            {projects.image && <img src={projects.image} alt={projects.name} />}

            <h3>{projects.name}</h3>

            <div class="project-tags">
              {projects.tags.map((tag) => (
                <span class="tag"> {tag} </span>
              ))}
            </div>

            <p class="project-description">{projects.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!--Contact-->

  <section class="contact-section" id="contact">
    <h2>Contact</h2>

    <div class="contact-line-horizontal"></div>

    <div class="contact-content">
      <a
        href={linkdin}
        target="_blank"
        aria-label="LinkedIn"
        class="social-link"
      >
        <svg
          viewBox="0 0 24 24"
          width="45"
          height="45"
          aria-hidden="true"
          class="linkedin-icon"
        >
          <rect width="24" height="24" fill="#fff" rx="4" ry="4"></rect>
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            fill="#0A66C2"></path>
        </svg>
      </a>
      <a href={github} target="_blank" aria-label="GitHub" class="social-link">
        <svg
          viewBox="0 0 24 24"
          width="45"
          height="45"
          aria-hidden="true"
          class="github-icon"
        >
          <circle cx="12" cy="12" r="12" fill="#fff"></circle>
          <path
            d="M12 4c-4.4 0-8 3.6-8 8 0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.8 2.3.6.1-.5.3-.8.5-1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.2 0 3.1-1.8 3.8-3.6 4 .3.3.6.8.6 1.6v2.4c0 .2.2.5.5.4 3.2-1.1 5.5-4.1 5.5-7.6 0-4.4-3.6-8-8-8z"
            fill="#000"></path>
        </svg>
      </a>
      <a
        href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`}
        target="_blank"
        aria-label="Email"
        class="social-link"
      >
        <svg
          viewBox="41 20 110 110"
          width="45"
          height="45"
          aria-hidden="true"
          class="mail-icon"
        >
          <path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6"
          ></path>
          <path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15"
          ></path>
          <path
            fill="#fbbc04"
            d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2"></path>
          <path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92"></path>
          <path
            fill="#c5221f"
            d="M52 51v8l20 15V48l-5.6-4.2c-5.94-4.45-14.4-.22-14.4 7.2"></path>
        </svg>
      </a>
    </div>
    <div class="contact-content-phone">
      <p>Phone :- +91 9325374664</p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-container {
    align-items: center;
    text-align: center;
    display: flex;
    flex: 1;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.4em;
  }

  /*Project*/

  .project-section {
    padding: 0;
  }

  .project-header {
    padding: 3rem 0;
    text-align: center;
    background: linear-gradient(90deg, #101010, #101010, #101010);
    border-bottom: 4px solid rgba(255, 255, 255, 0.05);
  }

  .project-header h2 {
    font-size: 2.2rem;
    margin: 0;
    text-align: center;
  }

  .project-grid {
    display: grid;
    background: linear-gradient(90deg, #101010, #101010, #101010);
    grid-template-columns: repeat(3, 1fr);
    gap: 3em;
    padding: 5em 0;
    margin-top: 0;
    border-bottom: 4px solid rgba(255, 255, 255, 0.05);
  }

  .project-card {
    justify-self: center;
    background: linear-gradient(
      145deg,
      rgba(41, 41, 48, 0.8),
      rgba(20, 20, 25, 0.95)
    );
    backdrop-filter: blur(10px);
    width: 360px;
    padding: 1.5em;
    border-radius: 4px;
    border: 2px solid rgba(255, 255, 255, 0.05);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .project-card img {
    display: block;
    margin: 0 auto;
    margin-top: 1em;
    margin-bottom: 2em;
    max-width: 270px;
    max-height: 270px;
  }

  .project-card i {
    font-size: 0.65em;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .project-description {
    font-size: 0.85em;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.15);
    background: linear-gradient(
      145deg,
      rgba(50, 50, 58, 0.85),
      rgba(25, 25, 30, 0.95)
    );
  }

  .project-card h3 {
    margin-bottom: 0.5em;
    font-size: 1.5rem;
  }

  .project-card p {
    opacity: 0.8;
    line-height: 1.4;
  }

  .caption {
    font-size: 0.8em;
    font-style: italic;
    text-align: left;
  }
  /*hero video*/

  .hero-video {
    position: relative;
    width: 100%;
    height: 100dvh;
    /* overflow: hidden; */
  }

  .hero-video video {
    position: absolute;
    opacity: 50%;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
  }
  /* .hero-about{
        background-color: #012f55;
        position:absolute;
  } */

  .hero-about {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    top: 450px;

    background: linear-gradient(45deg, #212121, #1d1d1dce, #1e1e1e7f);
  }
  .about-content {
    position: absolute;

    text-align: left;
    top: 0px;
    left: 160px;
  }

  .about-content p {
    font-size: 0.8em;
  }

  /* Contact */
  .contact-section {
    padding: 2rem 0 6rem 0;
    background: #000000;
  }
  .contact-section h2 {
    margin: 0;
    padding-bottom: 2rem;
    text-align: center;
    color: #ffffff;
    font-size: 2.2rem;
    font-weight: 400;
  }
  .contact-line-horizontal {
    width: 100%;
    height: 1px;
    background-color: #ffffff;
  }
  .contact-container {
    display: flex;
    justify-content: center;
    align-items: stretch;
    width: 100%;
  }

  .contact-content {
    flex: 1;
    padding: 3rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .contact-content-phone {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .contact-content-phone p {
    font-size: 1.2em;
  }
  .social-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .social-link:hover {
    transform: scale(1.1);
  }

  @media (max-width: 1200px) {
    p {
      font-size: 1.2em;
    }

    .hero-image {
      max-width: 400px;
    }

    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 3em 2em;
    }
  }

  @media (max-width: 800px) {
    .contact-container {
      flex-direction: column;
    }

    .contact-content {
      padding: 2rem;
      align-items: center;
    }

    .project-grid {
      grid-template-columns: 1fr;
      padding: 2em 1em;
      gap: 2em;
    }

    .project-card {
      width: 100%;
      max-width: 340px;
    }

    .hero-about {
      top: 60%;
    }

    .about-content {
      left: 20px;
      right: 20px;
    }
  }

  @media (max-width: 800px) {
    .home-container {
      flex-direction: column;
    }

    .home-copy {
      flex: 0;
      padding-bottom: 2em;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const video = document.getElementById("hero-video");

    if (video instanceof HTMLVideoElement) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        },
        { threshold: 0.25 },
      );

      observer.observe(video);
    }
  });
</script>
