---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ProfessionalProjects, PersonalProjects } from "../data/projects.js";

const title = "Anthony Dsouza";
const description = "Gameplay programmer";
const email = "dsouzaanthony781@gmail.com";
const phone = "+91 9325374664";
const github = "https://github.com/anthonythunder";
const linkedin = "https://www.linkedin.com/in/anthony-dsouza-12o4/";
const permalink = Astro.site?.href || Astro.url.href;

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---

<!--Home section-->
<BaseLayout title={title} description={description} permalink={permalink}>
  <!--Video section -->

  <section id="home" class="hero-video">
    <video
      id="hero-video"
      src={baseUrl + "assets/gameplay.mp4"}
      autoplay
      muted
      loop
      playsinline
    >
    </video>
    <div class="hero-overlay"></div>

    <div class="hero-about" id="about">
      <div class="about-container-inner">
        <div class="about-image">
          <img src={baseUrl + "assets/profile.png"} alt="Anthony Dsouza" />
        </div>
        <div class="about-content">
          <h2>Hi, I am Anthony Dsouza</h2>
          <p>
            I am a game programmer with experience in gameplay programming,
            VR/AR software development, and multiplayer games. <br />
            I am passionate about building engaging and innovative games that deliver
            immersive and unforgettable player experiences.
            <br /> My professional background includes working on Defense Force, Emergency
            Force, and Armed Force VR training simulators, <br />along with
            hands-on knowledge and practice in developing multiplayer projects.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!--Gameplay highlights -->

  <section id="highlights" class="highlights-section project-section">
    <header class="project-header">
      <h2>Gameplay highlights</h2>
    </header>

    <div class="highlights-carousel" data-base-url={baseUrl}>
      <div class="carousel-side prev-side" id="prev-video-trigger">
        <video
          class="side-video"
          id="prev-video-player"
          muted
          playsinline
          preload="metadata"></video>
        <div class="side-overlay"></div>
      </div>

      <div class="carousel-main">
        <button
          id="prev-video"
          class="carousel-btn carousel-btn-left"
          aria-label="Previous video">&#10094;</button
        >
        <video
          id="highlights-video-player"
          src={baseUrl + "assets/gameplay.mp4"}
          controls
          playsinline
          class="highlights-video"
        >
        </video>
        <button
          id="next-video"
          class="carousel-btn carousel-btn-right"
          aria-label="Next video">&#10095;</button
        >
      </div>

      <div class="carousel-side next-side" id="next-video-trigger">
        <video
          class="side-video"
          id="next-video-player"
          muted
          playsinline
          preload="metadata"></video>
        <div class="side-overlay"></div>
      </div>
    </div>
  </section>

  <!--Project section -->

  <section id="project" class="project-section">
    <header class="project-header">
      <h2>Professional projects</h2>
    </header>

    <div class="project-grid">
      {
        ProfessionalProjects.map((project) => (
          <article class="project-card">
            {project.image && <img src={project.image} alt={project.name} />}

            <h3>{project.name}</h3>

            <div class="project-info">
              <div class="info-item">
                <span class="info-label">Tech:</span>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag"> {tag} </span>
                  ))}
                </div>
              </div>

              <div class="info-item">
                <span class="info-label">Role:</span>
                <span class="info-value">
                  {project.role || "Unity Developer"}
                </span>
              </div>
            </div>

            <p class="project-description">{project.description}</p>

            {project.note && <i>{project.note}</i>}
          </article>
        ))
      }
    </div>
  </section>
  <!--Personal projects -->

  <section id="project" class="project-section">
    <header class="project-header">
      <h2>Personal work</h2>
    </header>

    <div class="project-grid">
      {
        PersonalProjects.map((project) => (
          <div class="project-link">
            <article class="project-card">
              {project.image && <img src={project.image} alt={project.name} />}

              <h3>{project.name}</h3>

              <div class="project-info">
                <div class="info-item">
                  <span class="info-label">Tech:</span>
                  <div class="project-tags">
                    {project.tags.map((tag) => (
                      <span class="tag"> {tag} </span>
                    ))}
                  </div>
                </div>

                <div class="info-item">
                  <span class="info-label">Role:</span>
                  <span class="info-value">
                    {project.role || "Unity Developer"}
                  </span>
                </div>
              </div>

              <p class="project-description">{project.description}</p>
            </article>
          </div>
        ))
      }
    </div>
  </section>
  <!--Contact-->

  <section class="contact-section" id="contact">
    <h2>Contact</h2>

    <div class="contact-line-horizontal"></div>

    <p class="contact-tagline">Open to opportunities — let's build something great</p>

    <div class="contact-content">
      <a
        href={linkedin}
        target="_blank"
        aria-label="LinkedIn"
        class="social-link"
      >
        <svg
          viewBox="0 0 24 24"
          width="45"
          height="45"
          aria-hidden="true"
          class="linkedin-icon"
        >
          <rect width="24" height="24" fill="#fff" rx="4" ry="4"></rect>
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            fill="#0A66C2"></path>
        </svg>
      </a>
      <a href={github} target="_blank" aria-label="GitHub" class="social-link">
        <svg
          viewBox="0 0 24 24"
          width="45"
          height="45"
          aria-hidden="true"
          class="github-icon"
        >
          <circle cx="12" cy="12" r="12" fill="#fff"></circle>
          <path
            d="M12 4c-4.4 0-8 3.6-8 8 0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.8 2.3.6.1-.5.3-.8.5-1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.2 0 3.1-1.8 3.8-3.6 4 .3.3.6.8.6 1.6v2.4c0 .2.2.5.5.4 3.2-1.1 5.5-4.1 5.5-7.6 0-4.4-3.6-8-8-8z"
            fill="#000"></path>
        </svg>
      </a>
      <a
        href={"https://mail.google.com/mail/?view=cm&fs=1&to=" + email}
        target="_blank"
        aria-label="Email"
        class="social-link"
      >
        <svg
          viewBox="41 20 110 110"
          width="45"
          height="45"
          aria-hidden="true"
          class="mail-icon"
        >
          <path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6"
          ></path>
          <path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15"
          ></path>
          <path
            fill="#fbbc04"
            d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2"></path>
          <path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92"></path>
          <path
            fill="#c5221f"
            d="M52 51v8l20 15V48l-5.6-4.2c-5.94-4.45-14.4-.22-14.4 7.2"></path>
        </svg>
      </a>
    </div>
    <div class="contact-content-phone">
      <p>Phone :- {phone}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-container {
    align-items: center;
    text-align: center;
    display: flex;
    flex: 1;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.4em;
  }

  /*Project*/

  .project-section {
    padding: 0;
  }

  .project-header {
    padding: 3rem 0;
    text-align: center;
    background: linear-gradient(90deg, #101010, #101010, #101010);
    border-bottom: 4px solid rgba(255, 255, 255, 0.05);
  }

  .project-header h2 {
    font-size: 3.5rem;
    margin: 0;
    text-align: center;
  }

  .project-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    background: linear-gradient(90deg, #101010, #101010, #101010);
    gap: 3em;
    padding: 5em 0;
    margin-top: 0;
    border-bottom: 4px solid rgba(255, 255, 255, 0.05);
  }

  .project-card {
    justify-self: center;
    background: linear-gradient(
      145deg,
      rgba(41, 41, 48, 0.8),
      rgba(20, 20, 25, 0.95)
    );
    backdrop-filter: blur(10px);
    width: 360px;
    padding: 1.5em;
    border-radius: 4px;
    border: 2px solid rgba(255, 255, 255, 0.05);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .project-card img {
    display: block;
    margin: 0 auto;
    margin-top: 1em;
    margin-bottom: 2em;
    max-width: 270px;
    max-height: 270px;
  }

  .project-card i {
    font-size: 0.65em;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-size: 0.85em;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.8rem 0;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .info-label {
    font-weight: 700;
    color: rgb(247, 255, 250);
    display: inline-block;
    width: 40px;
    flex-shrink: 0;
  }

  .info-value {
    color: var(--text-main);
  }

  .tag {
    background: rgba(84, 142, 155, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.72rem;
    border: 1px solid rgba(84, 142, 155, 0.35);
    color: #e2f2f4;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .project-description {
    font-size: 0.85em;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.15);
    background: linear-gradient(
      145deg,
      rgba(50, 50, 58, 0.85),
      rgba(25, 25, 30, 0.95)
    );
  }

  .project-card h3 {
    margin-bottom: 0.5em;
    font-size: 1.5rem;
  }

  .project-card p {
    opacity: 0.8;
    line-height: 1.4;
  }

  .caption {
    font-size: 0.8em;
    font-style: italic;
    text-align: left;
  }

  /* Highlights */
  .highlights-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2em 1em;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .carousel-side {
    position: relative;
    width: 25%;
    max-width: 300px;
    opacity: 0.4;
    cursor: pointer;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 1;
    border: 2px solid rgba(255, 255, 255, 0.05);
  }

  .carousel-side:hover {
    opacity: 0.8;
    transform: scale(1.02);
  }

  .side-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 16/9;
  }

  .side-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .carousel-main {
    flex: 0 0 auto;
    width: 60%;
    max-width: 800px;
    position: relative;
    z-index: 2;
  }

  .highlights-video {
    width: 100%;
    display: block;
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    background-color: #000;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(41, 41, 48, 0.8);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    width: 50px;
    height: 50px;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .carousel-btn-left {
    left: -25px;
  }

  .carousel-btn-right {
    right: -25px;
  }

  .carousel-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-50%) scale(1.1);
  }

  @media (max-width: 1000px) {
    .carousel-side {
      display: none;
    }
    .carousel-main {
      width: 100%;
      padding: 0 1em;
    }
    .carousel-btn-left {
      left: 10px;
    }
    .carousel-btn-right {
      right: 10px;
    }
  }

  /*hero video*/

  .hero-video {
    position: relative;
    width: 100%;
    height: 100dvh;
    /* overflow: hidden; */
  }

  .hero-video video {
    position: absolute;
    opacity: 50%;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
  }
  /* .hero-about{
        background-color: #012f55;
        position:absolute;
  } */

  .hero-about {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    top: 450px;

    background: linear-gradient(45deg, #212121, #1d1d1dce, #1e1e1e7f);
  }

  .about-container-inner {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 3.5rem;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.75em;
  }

  .about-image {
    flex-shrink: 0;
  }

  .about-image img {
    display: block;
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(84, 142, 155, 0.4);
    box-shadow: 0 0 25px rgba(84, 142, 155, 0.25);

    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .about-image img:hover {
    transform: scale(1.04);
    border-color: rgba(255, 255, 255, 1);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.4);
  }

  .about-content {
    flex: 1;
    text-align: left;
  }

  .about-content h2 {
    margin-top: 0;
  }

  .about-content p {
    font-size: 1em;
    font-family: "DM Sans", sans-serif;
    line-height: 1.6;
    margin: 0;
  }

  /* Contact */
  .contact-section {
    padding: 2rem 0 6rem 0;
    background: #000000;
  }
  .contact-section h2 {
    margin: 0;
    padding-bottom: 2rem;
    text-align: center;
    color: #ffffff;
    font-size: 2.2rem;
    font-weight: 400;
  }
  .contact-line-horizontal {
    width: 100%;
    height: 1px;
    background-color: #ffffff;
  }
  .contact-tagline {
    text-align: center;
    font-size: 1.4rem;
    color: var(--text-secondary);
    margin: 3rem 0 1rem 0;
    font-family: var(--font-family-sans);
    letter-spacing: 0.02em;
  }
  .contact-container {
    display: flex;
    justify-content: center;
    align-items: stretch;
    width: 100%;
  }

  .contact-content {
    flex: 1;
    padding: 3rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .contact-content-phone {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .contact-content-phone p {
    font-size: 1.2em;
  }
  .social-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .social-link:hover {
    transform: scale(1.1);
  }

  @media (max-width: 1200px) {
    p {
      font-size: 1.2em;
    }

    .hero-image {
      max-width: 400px;
    }

    .project-grid {
      padding: 3em 2em;
    }
  }

  @media (max-width: 800px) {
    .contact-container {
      flex-direction: column;
    }

    .contact-content {
      padding: 2rem;
      align-items: center;
    }

    .project-grid {
      padding: 2em 1em;
      gap: 2em;
    }

    .project-card {
      width: 100%;
      max-width: 340px;
    }

    .hero-about {
      top: 60%;
    }

    .about-container-inner {
      flex-direction: column;
      gap: 1.5rem;
      padding: 1.5rem;
      text-align: center;
    }

    .about-content {
      text-align: center;
    }

    .about-image {
      margin-left: 0;
    }

    .about-image img {
      width: 130px;
      height: 130px;
    }
  }

  @media (max-width: 800px) {
    .home-container {
      flex-direction: column;
    }

    .home-copy {
      flex: 0;
      padding-bottom: 2em;
      text-align: center;
    }
  }

  .project-link {
    text-decoration: none;
    color: inherit;
    display: block;
    outline: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const video = document.getElementById("hero-video");

    if (video instanceof HTMLVideoElement) {
      // Force mobile device autoplay compliance on SPA navigation
      video.muted = true;
      video.defaultMuted = true;
      video.load(); // Force the browser to reset the video stream to guarantee re-initialization
      video.play().catch(() => {});

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        },
        { threshold: 0.25 },
      );

      observer.observe(video);
    }

    // Highlights Video Carousel Logic
    const highlightsVideo = document.getElementById("highlights-video-player");
    const prevVideoPlayer = document.getElementById("prev-video-player");
    const nextVideoPlayer = document.getElementById("next-video-player");
    const prevBtn = document.getElementById("prev-video");
    const nextBtn = document.getElementById("next-video");
    const prevTrigger = document.getElementById("prev-video-trigger");
    const nextTrigger = document.getElementById("next-video-trigger");
    const highlightsContainer = document.querySelector(".highlights-carousel");

    if (highlightsVideo && highlightsContainer) {
      const rawBase = highlightsContainer.getAttribute("data-base-url") || "";
      const baseUrl = rawBase.endsWith("/") ? rawBase : rawBase + "/";

      // Add your video file paths here!
      const videos = [
        "assets/gameplay.mp4",
        "assets/Insas Test.mp4",
        "assets/Realestate A1.mp4",
        "assets/Vehicle Decontamination System 720.mp4",
      ];

      let currentVideoIndex = 0;

      const getPrevIndex = () =>
        (currentVideoIndex - 1 + videos.length) % videos.length;
      const getNextIndex = () => (currentVideoIndex + 1) % videos.length;

      const updateVideo = () => {
        if (highlightsVideo instanceof HTMLVideoElement) {
          highlightsVideo.src = baseUrl + videos[currentVideoIndex];
          highlightsVideo.play().catch(() => {});
        }
        if (prevVideoPlayer instanceof HTMLVideoElement) {
          prevVideoPlayer.src = baseUrl + videos[getPrevIndex()] + "#t=0.001";
        }
        if (nextVideoPlayer instanceof HTMLVideoElement) {
          nextVideoPlayer.src = baseUrl + videos[getNextIndex()] + "#t=0.001";
        }
      };

      // initialize thumbnails
      updateVideo();

      const goPrev = () => {
        currentVideoIndex = getPrevIndex();
        updateVideo();
      };

      const goNext = () => {
        currentVideoIndex = getNextIndex();
        updateVideo();
      };

      if (prevBtn) prevBtn.addEventListener("click", goPrev);
      if (nextBtn) nextBtn.addEventListener("click", goNext);
      if (prevTrigger) prevTrigger.addEventListener("click", goPrev);
      if (nextTrigger) nextTrigger.addEventListener("click", goNext);
    }
  });
</script>
