---
import Logo from './Logo.astro'
import Nav from './Nav.astro'

const { current = '' } = Astro.props;
---

<style>
  .header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    background: var(--background-body);
    width: 100%;
    /* Add a subtle shadow if it looks good, but keeping it simple for now */
  }

  /* This invisible box pushes the rest of the page down so the fixed header doesn't cover content initially */
  .header-spacer {
    height: 80px;
    width: 100%;
    display: block;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin: 0 auto;
    max-width: 1400px;
    height: 80px;
    padding: 1.75em;
    width: 100%;
  }

  @media screen and (max-width: 520px) {
    header {
      padding: 1em;
    }
  }
</style>

<div class="header-wrapper">
  <header>
    <Logo />
    <Nav current={current} />
  </header>
</div>
<div class="header-spacer"></div>
